# Vercel Server-Side Environment Variables ONLY
# Configure these in Vercel Dashboard -> Project Settings -> Environment Variables.
# NEVER put QF_CLIENT_SECRET inside Android .env or client-side code.

QF_CLIENT_ID=your_quran_foundation_client_id
QF_CLIENT_SECRET=your_quran_foundation_client_secret
QF_OAUTH_TOKEN_URL=https://oauth2.quran.foundation/oauth2/token
QF_API_BASE_URL=https://apis.quran.foundation/content/api/v4
QF_OAUTH_SCOPE=content
